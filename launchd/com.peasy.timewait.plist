<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.peasy.timewait</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/bot/peasy-auto/scripts/peasy-timewait-watchdog.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/bot/peasy-auto</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/bot/peasy-auto/logs.nosync/timewait.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bot/peasy-auto/logs.nosync/timewait.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PEASY_HOME</key>
    <string>/Users/bot/peasy-auto</string>
  </dict>
</dict>
</plist>
